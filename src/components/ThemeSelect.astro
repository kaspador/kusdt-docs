---
// The web app's day-and-night switch, in place of Starlight's dropdown.
const sun = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1.8v3M12 19.2v3M1.8 12h3M19.2 12h3M4.8 4.8l2.1 2.1M17.1 17.1l2.1 2.1M4.8 19.2l2.1-2.1M17.1 6.9l2.1-2.1" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>';
const moon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 13.4A9 9 0 1 1 10.6 3a7.2 7.2 0 0 0 10.4 10.4z"/></svg>';
---

<button type="button" role="switch" class="theme-switch" aria-label="Switch between dark and light" title="Switch between dark and light" data-theme-switch>
	<Fragment set:html={sun} /><Fragment set:html={moon} />
	<span class="theme-knob theme-knob-sun"><Fragment set:html={sun} /></span>
	<span class="theme-knob theme-knob-moon"><Fragment set:html={moon} /></span>
</button>

<script>
	const root = document.documentElement;
	const sync = () => document.querySelectorAll('[data-theme-switch]').forEach((b) => b.setAttribute('aria-checked', String(root.dataset.theme !== 'light')));
	document.querySelectorAll('[data-theme-switch]').forEach((b) => b.addEventListener('click', () => {
		const next = root.dataset.theme === 'light' ? 'dark' : 'light';
		root.dataset.theme = next;
		try { localStorage.setItem('starlight-theme', next); } catch { /* storage blocked: for this page only */ }
		sync();
	}));
	sync();
</script>
